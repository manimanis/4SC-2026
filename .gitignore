# =========================================================
# .gitignore - Projet 4SC-2026 (Informatique 4e Scientifique)
# =========================================================

# --- Fichiers temporaires et de verrouillage bureautique (LibreOffice / MS Office) ---
.~lock.*#
~$*
*.tmp
*.temp
*.bak
*.swp
*~

# --- Système d'exploitation (Windows / macOS / Linux) ---
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# --- Environnements de développement et éditeurs ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/

# --- Node.js / NPM ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Serveur local et logs Apache / XAMPP ---
*.log
access.log
error.log

# --- Fichiers de cache locaux et temporaires du projet ---
scratch/
.cache/
